{
	"permissions": {
		"allow": [
			"Bash(npm run new *)",
			"Bash(npm run start *)",
			"Bash(npm run solve *)",
			"Bash(npm run times)",
			"Bash(npm run watch *)",
			"Bash(wc *)",
			"Bash(head *)",
			"Bash(git branch --show-current)",
			"Bash(git branch -vv)",
			"Bash(npm run test)",
			"Bash(npm run test -- *)",
			"Bash(npm run test:ci)",
			"Bash(npm run lint)",
			"Bash(npm run fix)",
			"Bash(npm run build)",
			"Bash(npm run check)",
			"Bash(git status)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(git switch *)",
			"Bash(git pull --ff-only)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git push -u origin day-*)",
			"Bash(gh pr create *)",
			"Bash(gh pr view *)",
			"Bash(gh pr merge --auto --squash)"
		],
		"ask": ["Bash(npm run submit *)"],
		"deny": [
			"Read(./.env*)",
			"Read(./**/.env*)",
			"Bash(curl *)",
			"Bash(wget *)",
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git push origin main*)",
			"Bash(git commit *--no-verify*)",
			"Bash(git branch -D *)",
			"Bash(git branch -d *)",
			"Bash(rm -rf *)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash|Read",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard.ts\""
					}
				]
			}
		]
	}
}
