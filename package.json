{
	"name": "advent-of-code-2026",
	"version": "0.0.0",
	"private": true,
	"description": "Advent of Code 2026 solutions in TypeScript on Node 26",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"prepare": "lefthook install",
		"new": "node scripts/new.ts",
		"start": "node scripts/start.ts",
		"times": "node scripts/times.ts",
		"fetch": "node scripts/fetch.ts",
		"submit": "node scripts/submit.ts",
		"solve": "node scripts/run.ts",
		"watch": "node --watch scripts/run.ts",
		"test": "vitest run",
		"test:ci": "vitest run src/lib scripts",
		"test:watch": "vitest",
		"build": "tsc --noEmit",
		"lint": "biome check",
		"fix": "biome check --write",
		"check": "npm run lint && npm run build && npm run test:ci"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^26.6.6",
		"lefthook": "^2.2.2",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
